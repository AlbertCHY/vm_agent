# ─── Gemini (Supervisor 與 VM Provisioning 子圖) ───
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-3.8-flash
# Debug 用：顯示 Agent 思考過程與子圖步驟進度
SHOW_AGENT_THOUGHTS=false

# ─── VMware Aria Automation ───
AUTOMATION_URL=https://your-aria-automation.example.com
AUTOMATION_API_TOKEN=your-refresh-token
AUTOMATION_VERIFY_SSL=false
# AUTOMATION_HTTP_TIMEOUT=15
# GET 請求遇 429/5xx 的自動重試次數 (POST 不重試)
# AUTOMATION_HTTP_RETRIES=3

# ─── 本地 Ollama (工單解析) ───
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
# OLLAMA_TIMEOUT=300
# OLLAMA_NUM_CTX=8192
# OLLAMA_MAX_RAW_CHARS=6000

# ─── SSH (VM 磁碟診斷 & 免密登入) ───
SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa
SSH_PUBLIC_KEY_PATH=~/.ssh/id_rsa.pub
# 若想直接指定公鑰字串可填 SSH_PUBLIC_KEY (留空則優先讀取 SSH_PUBLIC_KEY_PATH 或 add_pub_key.sh 預設值)
# SSH_PUBLIC_KEY=ssh-ed25519 AAAA... user@my-pc
DEFAULT_SSH_USER=user1
# SSH_KEY_PASSPHRASE=
# SSH_PORT=22
# SSH_TIMEOUT=10
# true = 只連線 known_hosts 已存在的主機
# SSH_STRICT_HOST_KEY=false

# ─── 新 VM 初始化基本設定 (VM Bootstrap) ───
BOOTSTRAP_INIT_USER=user1
BOOTSTRAP_INIT_PASSWORD=your-template-initial-password
BOOTSTRAP_USER1=user1
BOOTSTRAP_USER2=user2
BOOTSTRAP_PASSWORD_LENGTH=12
CS_PROXY_HOST=your-proxy-host
CS_PROXY_PORT=3128
MDR_CID=your-MDR-cid
MDR_TOKEN=your-MDR-provisioning-token
NGAV_CID=your-NGAV-cid
NGAV_TOKEN=your-NGAV-provisioning-token
CROWDSTRIKE_DEFAULT_MODE=NGAV
# CROWDSTRIKE_LOCAL_DIR=./scripts/bootstrap/CrowdStrike
ZABBIX_SERVERS=your-zabbix-servers
ZABBIX_CONF_PATH=/etc/zabbix/zabbix_agentd.conf

# ─── 工單資料夾 (相對路徑以專案根目錄為基準) ───
# TICKETS_DIR=./tickets

# ─── 執行期資料與日誌 (相對路徑以專案根目錄為基準) ───
# checkpoint 資料庫 (等待審核 / 中斷的流程可續跑)
# DATA_DIR=./data
# CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
# LOG_DIR=./logs
# LOG_LEVEL=INFO

# ─── 業務規則 (policies/*.toml；找不到實際檔時使用 *.example.toml) ───
# POLICIES_DIR=./policies
